"""RMSprop optimizer component selected by the product configuration."""

from __future__ import annotations

from collections.abc import Iterable
from typing import Any

import torch


def make_optimizer(
    parameters: dict[str, Any],
    model_parameters: Iterable[torch.Tensor],
    learning_rate: float,
    role: str,
) -> torch.optim.Optimizer:
    """Create an independent RMSprop instance for one algorithm role."""

    del role
    return torch.optim.RMSprop(
        model_parameters,
        lr=float(learning_rate),
        alpha=float(parameters.get("optimizer.rmsprop.alpha", 0.99)),
        eps=float(parameters.get("optimizer.rmsprop.epsilon", 1e-8)),
        momentum=float(parameters.get("optimizer.rmsprop.momentum", 0.0)),
        weight_decay=float(parameters.get("optimizer.rmsprop.weight_decay", 0.0)),
        centered=bool(parameters.get("optimizer.rmsprop.centered", False)),
    )
