"""Generated product orchestration and immutable run recording."""

from __future__ import annotations

import argparse
import csv
import inspect
import json
import os
import platform
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from .evaluation import evaluate, summarize, write_plots
from .trainer import train


def _write_json(path: Path, payload: Any) -> None:
    with path.open("x", encoding="utf-8") as stream:
        json.dump(payload, stream, indent=2, sort_keys=True, allow_nan=False)
        stream.write("\n")


def _write_csv(path: Path, rows: list[dict[str, Any]]) -> None:
    with path.open("x", encoding="utf-8", newline="") as stream:
        writer = csv.DictWriter(stream, fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)


def _validate_runtime(config: dict[str, Any]) -> None:
    if config.get("algorithm_id") != "{{ALGORITHM_ID}}":
        raise ValueError("configuration algorithm does not match the generated runtime")
    if config.get("environment_id") != "{{ENVIRONMENT_ID}}":
        raise ValueError("configuration environment does not match the generated adapter")
    if config.get("behavior_id") != "{{BEHAVIOR_ID}}":
        raise ValueError("configuration behavior does not match the generated runtime")
    if config.get("optimizer_id") != "{{OPTIMIZER_ID}}":
        raise ValueError("configuration optimizer does not match the generated runtime")


def _execute_fixed(
    config: dict[str, Any],
    output: Path,
    run_id: str,
    full_artifacts: bool,
) -> dict[str, Any]:
    """Train and evaluate one fully materialized configuration."""

    _validate_runtime(config)
    progress_path = output / "training-progress.jsonl"

    def record_progress(event: dict[str, Any]) -> None:
        try:
            with progress_path.open("a", encoding="utf-8") as stream:
                json.dump(event, stream, sort_keys=True, allow_nan=False)
                stream.write("\n")
        except OSError:
            # Monitoring is observational: telemetry failure must not alter learning.
            return

    training_parameters = inspect.signature(train).parameters
    training = (
        train(config, progress=record_progress)
        if "progress" in training_parameters
        else train(config)
    )
    if config["checkpoint_policy"] == "best":
        training.agent.restore(training.best_snapshot)
    rows = evaluate(training.agent, config)
    results = summarize(rows, training, config)
    results["run_id"] = run_id
    results["training_episodes"] = len(training.rewards)

    metrics_path = output / "metrics.json"
    evaluation_path = output / "evaluation-episodes.csv"
    trace_path = output / "training-reward-trace.csv"
    config_copy = output / "resolved-configuration.json"
    _write_json(metrics_path, results)
    _write_csv(evaluation_path, rows)
    _write_csv(trace_path, [
        {
            "episode": index + 1,
            "reward": reward,
            "steps": training.steps[index],
            "success": training.successes[index],
        }
        for index, reward in enumerate(training.rewards)
    ])
    _write_json(config_copy, config)
    plot_paths = write_plots(output, rows, training, config) if full_artifacts else []

    artifacts = {
        "metrics": metrics_path.name,
        "evaluation_episodes": evaluation_path.name,
        "training_reward_trace": trace_path.name,
        "resolved_configuration": config_copy.name,
    }
    if progress_path.is_file():
        artifacts["training_progress"] = progress_path.name
    if full_artifacts and config["checkpoint_policy"] == "best":
        checkpoint_path = output / "{{CHECKPOINT_FILENAME}}"
        training.agent.save(checkpoint_path)
        artifacts["best_checkpoint"] = checkpoint_path.name
    elif full_artifacts and config["checkpoint_policy"] == "periodic":
        final_snapshot = training.agent.snapshot()
        base = Path("{{CHECKPOINT_FILENAME}}")
        for episode, snapshot in training.periodic_snapshots:
            training.agent.restore(snapshot)
            checkpoint_path = output / f"{base.stem}-episode-{episode}{base.suffix}"
            training.agent.save(checkpoint_path)
            artifacts[f"checkpoint_episode_{episode}"] = checkpoint_path.name
        training.agent.restore(final_snapshot)
    for path in plot_paths:
        artifacts[path.stem.replace("-", "_")] = path.name
    return {
        "metrics": results["metrics"],
        "results": results,
        "artifacts": artifacts,
        "effective_device": str(getattr(training.agent, "device", "cpu")),
    }


def run(config_path: Path, output_root: Path) -> Path:
    with config_path.open("r", encoding="utf-8") as stream:
        config = json.load(stream)
    _validate_runtime(config)

    started = datetime.now(timezone.utc)
    run_id = f"{started:%Y%m%dT%H%M%SZ}-{uuid.uuid4().hex[:8]}"
    output = output_root / run_id
    output.mkdir(parents=True, exist_ok=False)

    execution_mode = "hpo" if config.get("search") else "single"
    hpo_summary: dict[str, Any] | None = None
    final_config = config
    if execution_mode == "hpo":
        from .hpo import complete_search, fail_search, run_search

        try:
            search_result = run_search(config, output, _execute_fixed)
            final_config = search_result["configuration"]
            fixed_result = _execute_fixed(final_config, output, run_id, True)
            final_evidence = {
                **fixed_result["results"].get("metrics", {}),
                **fixed_result["results"].get("reward_summaries", {}),
            }
            hpo_summary = complete_search(output, final_evidence)
        except Exception as exc:
            fail_search(output, exc)
            raise
    else:
        fixed_result = _execute_fixed(config, output, run_id, True)

    artifacts = dict(fixed_result["artifacts"])
    if hpo_summary is not None:
        artifacts.update({
            "hpo_summary": "hpo-summary.json",
            "hpo_trials": "hpo-trials.jsonl",
            "hpo_best_configuration": "best-configuration.json",
        })

    ended = datetime.now(timezone.utc)
    effective_seeds = [
        final_config["effective_parameters"]["training.seed"]["value"],
        *final_config["evaluation"]["seeds"],
    ]
    if config.get("search"):
        effective_seeds.extend(config["search"]["seeds"])
    metadata: dict[str, Any] = {
        "schema_version": "1.0",
        "run_id": run_id,
        "status": "completed",
        "requested_configuration_hash": config["requested_configuration_hash"],
        # The base resolved hash remains the product identity. The selected
        # fixed configuration has its own hash in HPO metadata and artifacts.
        "resolved_configuration_hash": config["configuration_hash"],
        "component_versions": {
            config["environment_id"]: config["environment_version"],
            config["algorithm_id"]: config["algorithm_version"],
            config["behavior_id"]: config["behavior_version"],
            config["optimizer_id"]: config["optimizer_version"],
        },
        "started_at": started.isoformat(),
        "ended_at": ended.isoformat(),
        "effective_device": fixed_result["effective_device"],
        "python_version": platform.python_version(),
        "platform": platform.platform(),
        "effective_seeds": sorted(set(int(seed) for seed in effective_seeds)),
        "artifacts": artifacts,
        "execution_mode": execution_mode,
        "hpo": None,
    }
    if hpo_summary is not None:
        best = hpo_summary["best"]
        metadata["hpo"] = {
            "sampler": hpo_summary["sampler"],
            "objective": hpo_summary["objective"],
            "aggregation": hpo_summary["aggregation"],
            "trial_budget": hpo_summary["trial_budget"],
            "completed_trials": hpo_summary["completed_trials"],
            "failed_trials": hpo_summary["failed_trials"],
            "best_trial_number": best["trial_number"],
            "best_objective_value": best["objective_value"],
            "best_parameters": best["parameters"],
            "best_configuration_hash": final_config["configuration_hash"],
            "search_seeds": hpo_summary["search_seeds"],
            "sampler_seed": hpo_summary["sampler_seed"],
        }
    study_run_id = os.environ.get("RLSPL_STUDY_RUN_ID")
    if study_run_id:
        metadata["study"] = {
            "execution_id": os.environ["RLSPL_STUDY_EXECUTION_ID"],
            "study_hash": os.environ["RLSPL_STUDY_HASH"],
            "manifest_hash": os.environ["RLSPL_STUDY_MANIFEST_HASH"],
            "configuration_id": os.environ["RLSPL_CONFIGURATION_ID"],
            "study_run_id": study_run_id,
            "attempt": int(os.environ["RLSPL_STUDY_ATTEMPT"]),
            "training_seed": int(os.environ["RLSPL_TRAINING_SEED"]),
        }
    _write_json(output / "run-metadata.json", metadata)
    return output


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run generated RLSPL product")
    parser.add_argument("--config", type=Path, default=Path.cwd() / "config.json")
    parser.add_argument("--output", type=Path, default=Path.cwd() / "runs")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        output = run(args.config, args.output)
    except (OSError, ValueError, KeyError) as exc:
        print(f"Run failed: {exc}", file=sys.stderr)
        return 2
    print(f"Run completed: {output}")
    return 0
