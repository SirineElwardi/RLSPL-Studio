[build-system]
requires = ["setuptools>=65"]
build-backend = "setuptools.build_meta"

[project]
name = "{{PACKAGE_NAME}}"
version = "0.1.0"
description = "Standalone product generated by RLSPL Studio"
requires-python = ">=3.10"
dependencies = [
  {{DEPENDENCIES}}
]

[project.scripts]
rlspl-run = "rlspl_product.main:main"

[tool.setuptools.packages.find]
where = ["src"]
