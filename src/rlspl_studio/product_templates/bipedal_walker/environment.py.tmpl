"""Gymnasium BipedalWalker adapter."""

from __future__ import annotations

import gymnasium as gym
import numpy as np


GYMNASIUM_ID = "BipedalWalker-v3"


def make_environment(render_mode: str | None = None):
    return gym.make(GYMNASIUM_ID, hardcore=False, render_mode=render_mode)


def reached_goal(
    environment,
    observation: np.ndarray,
    terminated: bool,
    episode_reward: float,
) -> bool:
    return bool(episode_reward >= 300.0)
