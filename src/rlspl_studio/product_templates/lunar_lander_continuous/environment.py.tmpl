"""Gymnasium continuous LunarLander adapter."""

from __future__ import annotations

import gymnasium as gym
import numpy as np


def make_environment(render_mode: str | None = None):
    try:
        return gym.make("LunarLander-v3", continuous=True, render_mode=render_mode)
    except gym.error.Error:
        return gym.make("LunarLander-v2", continuous=True, render_mode=render_mode)


def reached_goal(
    environment,
    observation: np.ndarray,
    terminated: bool,
    episode_reward: float,
) -> bool:
    return bool(terminated and episode_reward >= 200.0)
