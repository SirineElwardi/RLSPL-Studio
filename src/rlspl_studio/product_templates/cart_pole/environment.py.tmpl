"""Gymnasium CartPole adapter."""

from __future__ import annotations

import gymnasium as gym
import numpy as np


GYMNASIUM_ID = "CartPole-v1"


def make_environment(render_mode: str | None = None):
    return gym.make(GYMNASIUM_ID, render_mode=render_mode)


def reached_goal(
    environment,
    observation: np.ndarray,
    terminated: bool,
    episode_reward: float,
) -> bool:
    # One episode succeeds only by surviving the complete 500-step horizon.
    return bool(episode_reward >= 500.0)
