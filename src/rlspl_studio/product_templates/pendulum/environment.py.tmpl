"""Gymnasium Pendulum adapter."""

from __future__ import annotations

import gymnasium as gym
import numpy as np


GYMNASIUM_ID = "Pendulum-v1"


def make_environment(render_mode: str | None = None):
    return gym.make(GYMNASIUM_ID, render_mode=render_mode)


def reached_goal(
    environment,
    observation: np.ndarray,
    terminated: bool,
    episode_reward: float,
) -> bool:
    # Pendulum-v1 is time-limited and has no native binary success event.
    return False
