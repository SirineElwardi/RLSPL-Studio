"""Compatibility behavior for legacy algorithm plug-ins."""

from __future__ import annotations


class BehaviorPolicy:
    def __init__(self, agent, action_space, parameters, seed: int) -> None:
        self.agent = agent

    def reset_episode(self, episode: int = 0, progress: float = 0.0) -> None:
        reset = getattr(self.agent, "reset_noise", None)
        if reset is not None:
            reset()

    def select_action(self, observation, step: int = 0, progress: float = 0.0):
        return self.agent.select_action(observation, epsilon=1.0)
