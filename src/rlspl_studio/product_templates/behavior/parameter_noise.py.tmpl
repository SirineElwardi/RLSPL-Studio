"""Scheduled parameter-space noise delegated to a perturbable agent model."""

from __future__ import annotations

import numpy as np


def _sigma(parameters, step: int, progress: float) -> float:
    start = float(parameters["behavior.parameter_noise.sigma_start"])
    end = float(parameters["behavior.parameter_noise.sigma_end"])
    schedule = parameters["behavior.parameter_noise.schedule"]
    if schedule == "constant":
        return start
    if schedule == "linear":
        return start + (end - start) * min(1.0, max(0.0, progress))
    return max(end, start * float(parameters["behavior.parameter_noise.decay"]) ** step)


class BehaviorPolicy:
    def __init__(self, agent, action_space, parameters, seed: int) -> None:
        self.agent = agent
        self.parameters = parameters
        self.rng = np.random.default_rng(seed + 262147)
        self.sigma = float(parameters["behavior.parameter_noise.sigma_start"])

    def reset_episode(self, episode: int = 0, progress: float = 0.0) -> None:
        self.sigma = _sigma(self.parameters, episode, progress)
        self.agent.reset_parameter_noise(self.sigma, self.rng)

    def select_action(self, observation, step: int = 0, progress: float = 0.0):
        return self.agent.perturbed_action(observation)
